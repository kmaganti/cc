# Hostinger Node.js Web App environment variables
NODE_ENV=production
HOST=0.0.0.0
DATA_DIR=storage/node
CC_USE_POSTGRES=true
PGHOST=168.231.72.72
PGPORT=32768
PGDATABASE=cc_db
PGUSER=cc_user
PGPASSWORD=replace-with-database-password
PGSSLMODE=disable

# Hostinger SMTP (orders and customer confirmations)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@cricketcentral.us
SMTP_PASS=replace-with-mailbox-password
ORDER_NOTIFICATIONS_ENABLED=true
ORDER_EMAIL_FROM=Cricket Central <orders@cricketcentral.us>

# Admin access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Cricket@2026

# Optional Resend configuration (only needed if EMAIL_PROVIDER=resend)
# Add your verified Resend API key in Hostinger's environment variables.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Cricket Central <orders@cricketcentral.us>
