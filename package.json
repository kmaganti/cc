{
  "name": "cricket-central",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:check": "node scripts/database-check.js",
    "email:check": "node scripts/email-check.js",
    "email:test": "node scripts/email-check.js --send",
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check server/index.js && node --check public/app.js && node --check public/admin.js && node --check server/commerce.js",
    "build": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "server/index.js",
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0"
  }
}
